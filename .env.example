# ===================================
# Viatica Backend — Environment Variables
# ===================================

# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas for production)
DATABASE_FULL_URL=mongodb://127.0.0.1:27017/viatica
# Production example:
# DATABASE_FULL_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/viatica?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Bootstrap / Emergency (CRITICAL: set strong secrets in production)
# Used to protect one-time admin creation and emergency resets.
# Send as header: x-bootstrap-secret / x-emergency-secret (or ?secret=)
SETUP_BOOTSTRAP_SECRET=change_this_bootstrap_secret
ADMIN_EMERGENCY_SECRET=change_this_emergency_secret
# Optional overrides (otherwise strong random will be generated):
# BOOTSTRAP_ADMIN_EMAIL=admin@viatica.com
# BOOTSTRAP_ADMIN_PHONE=0900000000
# BOOTSTRAP_ADMIN_PASSWORD=StrongOneTimePasswordHere
# ADMIN_EMERGENCY_PASSWORD=AnotherStrongPasswordHere

# CORS — Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,https://viatica-dashboard.vercel.app
# Production example:
# ALLOWED_ORIGINS=https://viatica-dashboard.vercel.app

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase (Push Notifications) — paste entire JSON as one line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Telegram OTP (Optional fallback)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Optional
ENABLE_AUDIT=false
